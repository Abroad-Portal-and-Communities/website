# Hugo build output
public/
resources/
.hugo_build.lock

# Hugo module vendor (local copy; pin theme via go.mod + go.sum)
_vendor/

# Local temp clones / experiments
.hextra-starter/

# OS
.DS_Store
Thumbs.db

# Dependencies (if you add Node tooling later)
node_modules/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Go workspace file
go.work
go.work.sum

# --- Secrets & local-only config (safe to run: git add .) ---
.env
.env.*
config/development/hugo.yaml
hugo.local.yaml
hugo.local.yml
hugo.local.toml

# Editor
.vscode/
.idea/
